{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lumen",
  "version": "0.12.2",
  "identifier": "io.github.andrea17982.lumen",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Lumen",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 540,
        "transparent": true,
        "windowEffects": { "effects": ["mica"] }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.icns", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"] }
}
